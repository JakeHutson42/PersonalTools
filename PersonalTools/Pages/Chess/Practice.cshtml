@page
@model PersonalTools.Pages.Chess.PracticeModel
@{ ViewData["Title"] = "Chess practice"; }
@section Head { <link rel="stylesheet" href="~/vendor/chess/board/package/assets/chessboard.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/pages/page-chess.css" asp-append-version="true" /> }
<main class="container py-4 chess-page chess-practice-page" data-chess-practice-page>
    <div class="chess-heading"><div><p class="text-uppercase small mb-1">Focused practice</p><h1>Openings &amp; endgames</h1><p>Learn a few plans you can remember, then practise the endings that matter most.</p></div><div class="chess-create-actions"><a class="btn btn-outline-secondary" asp-page="/Chess/Index">Back to games</a></div></div>
    <div class="chess-practice-tabs" role="tablist"><button type="button" class="active" data-practice-tab="openings" role="tab" aria-selected="true">Opening repertoire</button><button type="button" data-practice-tab="endgames" role="tab" aria-selected="false">Endgame drills</button></div>
    <section id="chessOpeningsPractice" class="chess-practice-section" aria-label="Opening practice"><div class="chess-practice-layout"><div class="card"><div class="card-body"><h2 class="h5">Your opening plans</h2><p class="small mb-3">Choose up to three plans for White and Black. You can practise each one in a minute or two.</p><div class="chess-repertoire-controls"><label for="chessWhiteOpening">When you play White</label><select id="chessWhiteOpening" class="form-select"></select><button id="chessSaveWhite" type="button" class="btn btn-outline-secondary btn-sm">Add White plan</button><label for="chessBlackOpening">When you play Black</label><select id="chessBlackOpening" class="form-select"></select><button id="chessSaveBlack" type="button" class="btn btn-outline-secondary btn-sm">Add Black plan</button></div><div id="chessRepertoire" class="chess-repertoire-list"></div><p id="chessDeviations" class="chess-deviations small" role="status">Checking your recent games…</p></div></div>
        <section class="card chess-practice-board-card"><div class="card-body"><div class="chess-practice-board-heading"><div><span id="chessPracticeLabel" class="chess-puzzle-theme">Opening practice</span><h2 id="chessPracticeTitle" class="h5 mb-1">Choose a saved plan</h2><p id="chessPracticePrompt" class="mb-0"></p></div><button id="chessPracticeReset" type="button" class="btn btn-outline-secondary btn-sm">Reset</button></div><div id="chessPracticeBoard" class="chess-practice-board" aria-label="Opening practice board"></div><p id="chessPracticeFeedback" class="chess-puzzle-feedback" role="status"></p></div></section></div></section>
    <section id="chessEndgamesPractice" class="chess-practice-section" aria-label="Endgame drills" hidden><div class="chess-practice-layout"><div class="card"><div class="card-body"><h2 class="h5">Resettable drills</h2><div id="chessDrillList" class="chess-drill-list"></div></div></div><section class="card chess-practice-board-card"><div class="card-body"><div class="chess-practice-board-heading"><div><span id="chessDrillLabel" class="chess-puzzle-theme">Endgame drill</span><h2 id="chessDrillTitle" class="h5 mb-1">Choose a drill</h2><p id="chessDrillPrompt" class="mb-0"></p></div><button id="chessDrillReset" type="button" class="btn btn-outline-secondary btn-sm">Reset drill</button></div><div id="chessDrillBoard" class="chess-practice-board" aria-label="Endgame drill board"></div><p id="chessDrillFeedback" class="chess-puzzle-feedback" role="status"></p></div></section></div></section>
</main>
@section Scripts { <script type="module" src="~/js/pages/page-chess-practice.js" asp-append-version="true"></script> }
