@if (User.Identity?.IsAuthenticated != true && Model.GuestAccessEnabled)
{
    <div class="modal fade case-guest-onboarding" id="caseGuestOnboarding" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="caseGuestOnboardingTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
            <div class="modal-body p-4 p-md-5">
                <span class="case-guest-onboarding-icon"><i class="fa-solid fa-dice" aria-hidden="true"></i></span>
                <p class="eyebrow mb-1">Welcome to Case Tycoon</p><h2 class="h3 mb-2" id="caseGuestOnboardingTitle">Choose your player name</h2>
                <p class="small-muted mb-4">Your progress is saved securely to this browser. You can play the full simulator and join case battles without a Personal Tools login.</p>
                <form id="caseGuestOnboardingForm" novalidate>
                    <label class="form-label" for="caseGuestUsername">Username</label>
                    <div class="input-group"><span class="input-group-text">@@</span><input class="form-control" id="caseGuestUsername" name="username" minlength="3" maxlength="24" pattern="[A-Za-z0-9][A-Za-z0-9_-]*[A-Za-z0-9]" autocomplete="username" required autofocus /></div>
                    <div class="form-text">3–24 letters, numbers, underscores or hyphens.</div>
                    <div class="alert alert-danger d-none mt-3 mb-0" id="caseGuestOnboardingError" role="alert"></div>
                    <button class="btn btn-warning w-100 mt-4" id="caseGuestOnboardingSubmit" type="submit"><i class="fa-solid fa-play me-2" aria-hidden="true"></i>Start playing</button>
                </form>
                <p class="case-guest-cookie-note mb-0 mt-3"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Keep this browser’s site data to retain access to your guest account.</p>
                <a class="case-guest-sign-in" asp-page="/Login" asp-route-ReturnUrl="/CaseOpening">Already have an account? Sign in</a>
            </div>
        </div></div>
    </div>
}
else if (User.Identity?.IsAuthenticated != true)
{
    <div class="modal fade case-guest-onboarding" id="caseGuestUnavailable" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="caseGuestUnavailableTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-body p-4 p-md-5 text-center">
            <span class="case-guest-onboarding-icon mx-auto"><i class="fa-solid fa-lock" aria-hidden="true"></i></span>
            <p class="eyebrow mb-1">Guest access paused</p><h2 class="h3 mb-2" id="caseGuestUnavailableTitle">Case Tycoon guest access is currently unavailable</h2>
            <p class="small-muted mb-4">New and existing guest sessions are paused. No guest progress has been deleted.</p>
            <a class="btn btn-warning w-100" asp-page="/Login" asp-route-ReturnUrl="/CaseOpening"><i class="fa-solid fa-right-to-bracket me-2" aria-hidden="true"></i>Sign in</a>
        </div></div></div>
    </div>
}

