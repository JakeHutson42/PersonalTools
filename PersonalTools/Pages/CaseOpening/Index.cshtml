                    <form id="caseTweakResetForm">
                        <button type="button" class="btn btn-outline-danger w-100 position-relative overflow-hidden hold-delete-btn" data-hold-form="caseTweakResetForm" data-hold-modal="caseTweakResetModal" data-hold-duration-ms="2500">
                            <span class="hold-delete-fill"></span>
                            <span class="hold-delete-label position-relative">Hold to reset your account</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="caseGuestAccessDangerModal" tabindex="-1" aria-labelledby="caseGuestAccessDangerTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
            <div class="modal-header"><div><p class="eyebrow mb-1">Protected setting</p><h2 class="modal-title fs-5" id="caseGuestAccessDangerTitle">Change guest access?</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <div class="modal-body">
                <div class="alert alert-danger"><i class="fa-solid fa-triangle-exclamation me-2" aria-hidden="true"></i><span id="caseGuestAccessDangerCopy">This changes access for every browser-based guest account.</span></div>
                <label class="form-label fw-semibold" for="caseGuestAccessDangerInput">Type <code>DANGER</code> to confirm</label>
                <input class="form-control" id="caseGuestAccessDangerInput" type="text" autocomplete="off" spellcheck="false" />
            </div>
            <div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-danger" id="caseGuestAccessDangerSave" type="button" disabled>Save guest access setting</button></div>
        </div></div>
    </div>

    <div class="modal fade" id="caseTweakModal" tabindex="-1" aria-labelledby="caseTweakTitle" aria-hidden="true">
        <div class="modal-dialog modal-fullscreen case-admin-modal-dialog">
            <div class="modal-content case-admin-modal">
                <div class="modal-header">
