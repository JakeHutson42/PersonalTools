                                        <div class="col-12"><div class="case-tweak-setting-heading"><i class="fa-solid fa-box-archive" aria-hidden="true"></i><div><strong>Inventory storage</strong><span>Container pricing, capacity and account limits.</span></div></div></div>
                                        <div class="col-6 col-md-4 col-lg-3"><label class="form-label small fw-semibold" for="caseTweakStorageBaseGbp">Storage base (£)</label><input class="form-control" id="caseTweakStorageBaseGbp" type="number" min="0" step=".01" /></div>
                                        <div class="col-6 col-md-4 col-lg-3"><label class="form-label small fw-semibold" for="caseTweakStorageIncrementGbp">Storage increment (£)</label><input class="form-control" id="caseTweakStorageIncrementGbp" type="number" min="0" step=".01" /></div>
                                        <div class="col-6 col-md-4 col-lg-3">
                                            <label class="form-label small fw-semibold" for="caseTweakStorageBaseCost">Storage base cost (Stars)</label>
                                            <input class="form-control" id="caseTweakStorageBaseCost" type="number" min="0" step="1" />
                                        </div>
                                        <div class="col-6 col-md-4 col-lg-3">
                                            <label class="form-label small fw-semibold" for="caseTweakStorageCostIncrement">Storage cost increment (Stars)</label>
                                            <input class="form-control" id="caseTweakStorageCostIncrement" type="number" min="0" step="1" />
                                        </div>
                                        <div class="col-6 col-md-4 col-lg-3">
                                            <label class="form-label small fw-semibold" for="caseTweakStorageSlots">Storage slots per container</label>
                                            <input class="form-control" id="caseTweakStorageSlots" type="number" min="1" step="1" />
                                        </div>
                                        <div class="col-6 col-md-4 col-lg-3">
                                            <label class="form-label small fw-semibold" for="caseTweakMaxStorage">Maximum storage containers</label>
                                            <input class="form-control" id="caseTweakMaxStorage" type="number" min="0" step="1" />
                                        </div>
                                    </div>
                                    <button class="btn btn-warning mt-4" type="submit">Save game settings</button>
                                </form>

                                <section class="case-admin-section" aria-labelledby="caseTweakXpRarityTitle">
                                    <div class="case-admin-section-title"><i class="fa-solid fa-ranking-star" aria-hidden="true"></i><div><strong id="caseTweakXpRarityTitle">XP per rarity</strong><span>Shared rewards applied when any account opens a skin.</span></div></div>
                                    <div class="table-responsive case-admin-table-wrap">
                                        <table class="table table-sm align-middle case-tweak-cases-table" id="caseTweakXpByRarityTable">
                                            <thead>
                                                <tr>
                                                    <th>Rarity</th>
                                                    <th>XP awarded</th>
                                                </tr>
                                            </thead>
                                            <tbody id="caseTweakXpByRarityTableBody"></tbody>
                                        </table>
                                    </div>
                                    <button class="btn btn-warning" type="button" id="saveCaseTweakXpByRarity">Save XP rewards</button>
                                </section>

                                <section class="case-admin-section" aria-labelledby="caseTweakInventoryUpgradeTitle">
                                    <div class="case-admin-section-title"><i class="fa-solid fa-box-open" aria-hidden="true"></i><div><strong id="caseTweakInventoryUpgradeTitle">Inventory upgrade catalogue</strong><span>Shared prices and level requirements for bulk-selling and rarity auto-sell.</span></div></div>
                                    <div class="table-responsive case-admin-table-wrap">
                                        <table class="table table-sm align-middle case-tweak-cases-table" id="caseTweakInventoryUpgradesTable">
                                            <thead><tr><th>Upgrade</th><th>Category</th><th>Cost (Stars)</th><th>Cost (£)</th><th>Required level</th></tr></thead>
                                            <tbody id="caseTweakInventoryUpgradesTableBody"></tbody>
                                        </table>
                                    </div>
                                    <button class="btn btn-warning" type="button" id="saveCaseTweakInventoryUpgrades">Save inventory upgrades</button>
                                </section>
                            </div>

                            <div class="tab-pane fade" id="caseTweakCasesPane" role="tabpanel" aria-labelledby="caseTweakCasesTab">
                                <div class="case-admin-section-title mb-3"><i class="fa-solid fa-boxes-stacked" aria-hidden="true"></i><div><strong>Case catalogue</strong><span>Shared unlock, restock and level requirements for every account.</span></div></div>
                                <div class="table-responsive case-admin-table-wrap">
                                    <table class="table table-sm align-middle case-tweak-cases-table" id="caseTweakCasesTable">
                                        <thead>
                                            <tr>
                                                <th>Case</th>
                                                <th>Tier</th>
                                                <th>Unlock cost (Stars)</th>
                                                <th>Unlock cost (£)</th>
                                                <th>Purchase cost (Stars)</th>
                                                <th>Purchase cost (£)</th>
                                                <th>Required level</th>
                                            </tr>
                                        </thead>
                                        <tbody id="caseTweakCasesTableBody"></tbody>
                                    </table>
                                </div>
                                <button class="btn btn-warning" type="button" id="saveCaseTweakCosts">Save all case costs</button>
                            </div>

                            <div class="tab-pane fade" id="caseTweakPricesPane" role="tabpanel" aria-labelledby="caseTweakPricesTab">
                                <section class="case-market-lab">
                                    <div class="case-tweak-setting-heading mb-3"><i class="fa-solid fa-sterling-sign" aria-hidden="true"></i><div><strong>Market balance lab</strong><span>Review an immutable Skinport draft, then explicitly publish its balanced GBP case prices.</span></div></div>
                                    <div class="case-market-lab-toolbar">
                                        <button class="btn btn-outline-warning" id="casePublishPriceBalance" type="button"><i class="fa-solid fa-check-double me-1" aria-hidden="true"></i>Publish balanced prices</button>
                                        <button class="btn btn-warning" id="caseCreatePriceSnapshot" type="button"><i class="fa-solid fa-cloud-arrow-down me-1" aria-hidden="true"></i>New snapshot</button>
                                    </div>
                                    <div class="case-market-active mt-3" id="caseMarketActiveSnapshot" aria-live="polite"><span>No active snapshot</span></div>
                                    <div class="alert alert-warning mt-3 mb-0 d-none" id="caseMarketPriceWarning" role="alert"></div>
                                    <div class="row g-2 mt-2" id="caseMarketSummary" aria-label="Snapshot pricing summary">
                                        <div class="col-6 col-xl-3"><div class="case-market-summary-card"><span>Skinport</span><strong id="caseMarketSkinportCount">0</strong><small>primary prices</small></div></div>
                                        <div class="col-6 col-xl-3"><div class="case-market-summary-card"><span>CSFloat</span><strong id="caseMarketCsFloatCount">0</strong><small>exact backups</small></div></div>
                                        <div class="col-6 col-xl-3"><div class="case-market-summary-card"><span>Inferred</span><strong id="caseMarketInferredCount">0</strong><small>review required</small></div></div>
                                        <div class="col-6 col-xl-3"><div class="case-market-summary-card"><span>Publish state</span><strong id="caseMarketPublishState">Blocked</strong><small id="caseMarketPublishReason">Load a snapshot</small></div></div>
                                    </div>
                                    <div class="case-market-snapshot-list mt-3" id="caseMarketSnapshotList"></div>
                                    <section class="case-market-tier-editor mt-4" aria-labelledby="caseMarketTierCurveTitle">
                                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                                            <div><h3 class="h6 mb-1" id="caseMarketTierCurveTitle">Tier profit curve</h3><p class="small-muted mb-0">Base profit is multiplied by the global target-return setting before recommendations are rounded.</p></div>
                                            <button class="btn btn-outline-warning btn-sm" id="caseSaveTierEconomy" type="button"><i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i>Save tier curve</button>
                                        </div>
                                        <div class="table-responsive"><table class="table table-sm align-middle case-market-table mb-0"><thead><tr><th>Tier</th><th>Base profit (%)</th><th>Round prices to (£)</th><th>Effective return</th></tr></thead><tbody id="caseMarketTierSettings"></tbody></table></div>
                                    </section>
                                    <section class="case-special-variant-lab mt-4" aria-labelledby="caseSpecialVariantHeading">
                                        <div class="case-tweak-setting-heading mb-3"><i class="fa-solid fa-gem" aria-hidden="true"></i><div><strong id="caseSpecialVariantHeading">Rare variants</strong><span>Curate float, seed and phase rules; prices are published only through an immutable GBP snapshot.</span></div></div>
                                        <div class="case-market-active is-empty mb-3" id="caseSpecialVariantActiveSnapshot" aria-live="polite"><span>No active rare-variant snapshot</span></div>
                                        <form id="caseSpecialVariantRuleForm" class="row g-2" novalidate>
                                            <div class="col-md-4"><label class="form-label small" for="caseVariantSourceItemId">Source item ID</label><input class="form-control form-control-sm" id="caseVariantSourceItemId" required maxlength="160"></div>
                                            <div class="col-md-8"><label class="form-label small" for="caseVariantMarketHashName">CSFloat market hash name</label><input class="form-control form-control-sm" id="caseVariantMarketHashName" required maxlength="300" placeholder="StatTrak™ AK-47 | Case Hardened (Factory New)"></div>
                                            <div class="col-md-3"><label class="form-label small" for="caseVariantName">Variant name</label><input class="form-control form-control-sm" id="caseVariantName" required maxlength="160"></div>
                                            <div class="col-md-2"><label class="form-label small" for="caseVariantTier">Tier</label><input class="form-control form-control-sm" id="caseVariantTier" required maxlength="40" placeholder="Tier 1"></div>
                                            <div class="col-md-3"><label class="form-label small" for="caseVariantSeed">Pattern seed</label><input class="form-control form-control-sm" id="caseVariantSeed" type="number" min="0" max="1000" placeholder="Optional"></div>
                                            <div class="col-md-8"><label class="form-label small" for="caseVariantDescription">Why it is rare</label><input class="form-control form-control-sm" id="caseVariantDescription" required maxlength="500"></div>
                                            <div class="col-md-2"><label class="form-label small" for="caseVariantMinFloat">Min float</label><input class="form-control form-control-sm" id="caseVariantMinFloat" type="number" min="0" max="1" step=".000001"></div>
                                            <div class="col-md-2"><label class="form-label small" for="caseVariantMaxFloat">Max float</label><input class="form-control form-control-sm" id="caseVariantMaxFloat" type="number" min="0" max="1" step=".000001"></div>
                                            <div class="col-md-3"><label class="form-label small" for="caseVariantPhase">Phase</label><input class="form-control form-control-sm" id="caseVariantPhase" maxlength="50" placeholder="Optional"></div>
                                            <div class="col-md-3"><label class="form-label small" for="caseVariantStatTrak">StatTrak</label><select class="form-select form-select-sm" id="caseVariantStatTrak"><option value="">Either</option><option value="true">Required</option><option value="false">Not StatTrak</option></select></div>
                                            <div class="col-md-2 d-flex align-items-end"><button class="btn btn-outline-warning btn-sm w-100" type="submit"><i class="fa-solid fa-plus me-1" aria-hidden="true"></i>Add rule</button></div>
                                        </form>
                                        <div class="table-responsive mt-3"><table class="table table-sm align-middle case-market-table"><thead><tr><th>Rule</th><th>Match</th><th>GBP price</th></tr></thead><tbody id="caseSpecialVariantRules"></tbody></table></div>
                                        <div class="row g-2 align-items-end"><div class="col-md-4"><label class="form-label small" for="caseVariantSnapshotName">Snapshot name</label><input class="form-control form-control-sm" id="caseVariantSnapshotName" maxlength="160" placeholder="August rare variants"></div><div class="col-md-4"><label class="form-label small" for="caseVariantSnapshotSource">Source / notes</label><input class="form-control form-control-sm" id="caseVariantSnapshotSource" maxlength="160" placeholder="Reviewed sales"></div><div class="col-md-2"><button class="btn btn-outline-warning btn-sm w-100" id="caseImportCsFloatEvidence" type="button">Find CSFloat listings</button></div><div class="col-md-2"><button class="btn btn-warning btn-sm w-100" id="caseCreateVariantSnapshot" type="button">Publish snapshot</button></div></div>
                                        <div class="small-muted mt-2" id="caseCsFloatEvidence" aria-live="polite"></div>
                                        <div class="case-market-snapshot-list mt-3" id="caseSpecialVariantSnapshots"></div>
                                    </section>
                                    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mt-4 mb-2">
                                        <div><h3 class="h6 mb-1">Case balance curve</h3><p class="small-muted mb-0">Published market prices drive both currencies: £100 equals 100 Stars. Keys are intentionally excluded.</p></div>
                                        <span class="small-muted" id="caseMarketCoverage">No snapshot loaded</span>
                                    </div>
                                    <div class="row g-2 mb-2 case-market-filters">
                                        <div class="col-12 col-md"><label class="visually-hidden" for="caseMarketSearch">Search cases</label><div class="input-group input-group-sm"><span class="input-group-text"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></span><input class="form-control" id="caseMarketSearch" type="search" placeholder="Search cases and capsules"></div></div>
                                        <div class="col-6 col-md-2"><label class="visually-hidden" for="caseMarketTierFilter">Filter tier</label><select class="form-select form-select-sm" id="caseMarketTierFilter"><option value="">All tiers</option></select></div>
                                        <div class="col-6 col-md-3"><label class="visually-hidden" for="caseMarketQualityFilter">Filter price quality</label><select class="form-select form-select-sm" id="caseMarketQualityFilter"><option value="">All quality states</option><option value="ready">Publish ready</option><option value="warning">Needs review</option><option value="missing">Missing prices</option></select></div>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-sm align-middle case-tweak-cases-table case-market-table">
                                            <thead><tr><th>Case</th><th>Tier</th><th>Market cost</th><th>Expected value</th><th>Inferred EV</th><th>Sale value</th><th>Target return</th><th>Recommended buy</th><th>Published buy</th><th>Quality</th></tr></thead>
                                            <tbody id="caseMarketCaseTableBody"></tbody>
                                        </table>
                                    </div>
                                </section>
                            </div>
                            <div class="tab-pane fade" id="caseTweakBattlesPane" role="tabpanel" aria-labelledby="caseTweakBattlesTab">
                                <section class="case-admin-section case-battle-admin-section" aria-labelledby="caseTweakBattlesTitle">
                                    <div class="case-admin-section-title"><i class="fa-solid fa-trophy" aria-hidden="true"></i><div><strong id="caseTweakBattlesTitle">Case Battles control</strong><span>Publish the feature, manage the instant Battle Bot and recover interrupted rooms.</span></div></div>
                                    <div class="row g-3 align-items-stretch">
                                        <div class="col-12 col-md-6"><label class="case-admin-feature-toggle h-100" for="caseTweakBattlesEnabled"><input type="checkbox" role="switch" id="caseTweakBattlesEnabled" disabled><span class="case-admin-feature-copy"><strong>Case Battles</strong><small>Allow players to create battles and buy all required cases.</small></span><span class="case-admin-feature-state" aria-hidden="true"></span></label></div>
                                        <div class="col-12 col-md-6"><label class="case-admin-feature-toggle h-100" for="caseTweakBattleFfa3Enabled"><input type="checkbox" role="switch" id="caseTweakBattleFfa3Enabled" disabled><span class="case-admin-feature-copy"><strong>1v1v1 battles</strong><small>Allow three-player free-for-all rooms with winner-takes-all settlement.</small></span><span class="case-admin-feature-state" aria-hidden="true"></span></label></div>
                                        <div class="col-12 col-md-6"><label class="case-admin-feature-toggle h-100" for="caseTweakBattleFfa4Enabled"><input type="checkbox" role="switch" id="caseTweakBattleFfa4Enabled" disabled><span class="case-admin-feature-copy"><strong>1v1v1v1 battles</strong><small>Allow four-player free-for-all rooms with winner-takes-all settlement.</small></span><span class="case-admin-feature-state" aria-hidden="true"></span></label></div>
                                        <div class="col-12 col-md-6"><label class="case-admin-feature-toggle h-100" for="caseTweakBattleBotEnabled"><input type="checkbox" role="switch" id="caseTweakBattleBotEnabled" disabled><span class="case-admin-feature-copy"><strong>Battle Bot</strong><small>Offer an auto-ready system opponent once Case Battles are live.</small></span><span class="case-admin-feature-state" aria-hidden="true"></span></label></div>
                                    </div>
                                </section>
                                <section class="case-admin-section case-battle-admin-section" aria-labelledby="caseTweakBattleBotStatsTitle">
                                    <div class="case-admin-section-title"><i class="fa-solid fa-robot" aria-hidden="true"></i><div><strong id="caseTweakBattleBotStatsTitle">Battle Bot record</strong><span>Bot wins are tracked for oversight; its items and value are discarded.</span></div></div>
                                    <div class="row g-2" id="caseTweakBattleBotStats"><div class="col-6 col-lg-3"><div class="case-admin-stat"><span>Attempted</span><strong>—</strong></div></div><div class="col-6 col-lg-3"><div class="case-admin-stat"><span>Won</span><strong>—</strong></div></div><div class="col-6 col-lg-3"><div class="case-admin-stat"><span>Skins discarded</span><strong>—</strong></div></div><div class="col-6 col-lg-3"><div class="case-admin-stat"><span>Value discarded</span><strong>—</strong></div></div></div>
                                </section>
                                <section class="case-admin-section case-battle-admin-section" aria-labelledby="caseTweakBattleTimingTitle">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div class="case-admin-section-title mb-0"><i class="fa-solid fa-stopwatch" aria-hidden="true"></i><div><strong id="caseTweakBattleTimingTitle">Battle animation timing</strong><span>Values are milliseconds and apply to newly loaded battle pages.</span></div></div><button class="btn btn-warning btn-sm" id="caseTweakBattleTimingsSave" type="button"><i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i>Save timing</button></div>
                                    <form id="caseTweakBattleTimingsForm" class="row g-2">
                                        <div class="col-6 col-lg-3"><label class="form-label small" for="caseTweakBattleReadyPauseMs">Ready pause</label><input class="form-control form-control-sm" id="caseTweakBattleReadyPauseMs" type="number" min="0" max="10000" step="100"></div>
                                        <div class="col-6 col-lg-3"><label class="form-label small" for="caseTweakBattleReadyCountdownMs">Countdown</label><input class="form-control form-control-sm" id="caseTweakBattleReadyCountdownMs" type="number" min="0" max="15000" step="100"></div>
                                        <div class="col-6 col-lg-3"><label class="form-label small" for="caseTweakBattlePreSpinPauseMs">Pre-spin attention delay</label><input class="form-control form-control-sm" id="caseTweakBattlePreSpinPauseMs" type="number" min="0" max="10000" step="100"></div>
                                        <div class="col-6 col-lg-3"><label class="form-label small" for="caseTweakBattleSpinDurationMs">Spin duration</label><input class="form-control form-control-sm" id="caseTweakBattleSpinDurationMs" type="number" min="500" max="20000" step="100"></div>
                                        <div class="col-6 col-lg-3"><label class="form-label small" for="caseTweakBattleLandedResultPauseMs">Landed result hold</label><input class="form-control form-control-sm" id="caseTweakBattleLandedResultPauseMs" type="number" min="0" max="5000" step="100"></div>
                                        <div class="col-6 col-lg-3"><label class="form-label small" for="caseTweakBattleRoundRevealPauseMs">Next spin delay</label><input class="form-control form-control-sm" id="caseTweakBattleRoundRevealPauseMs" type="number" min="0" max="10000" step="100"></div>
                                        <div class="col-6 col-lg-3"><label class="form-label small" for="caseTweakBattleResultsPauseMs">Results pause</label><input class="form-control form-control-sm" id="caseTweakBattleResultsPauseMs" type="number" min="0" max="10000" step="100"></div>
                                        <div class="col-6 col-lg-3"><label class="form-label small" for="caseTweakBattleWinnerIntroPauseMs">Winner intro</label><input class="form-control form-control-sm" id="caseTweakBattleWinnerIntroPauseMs" type="number" min="0" max="10000" step="100"></div>
                                        <div class="col-6 col-lg-3"><label class="form-label small" for="caseTweakBattleWinnerTallyDurationMs">Winner tally</label><input class="form-control form-control-sm" id="caseTweakBattleWinnerTallyDurationMs" type="number" min="250" max="20000" step="100"></div>
                                        <div class="col-6 col-lg-3"><label class="form-label small" for="caseTweakBattleWinnerVerdictPauseMs">Verdict pause</label><input class="form-control form-control-sm" id="caseTweakBattleWinnerVerdictPauseMs" type="number" min="0" max="10000" step="100"></div>
                                        <div class="col-6 col-lg-3"><label class="form-label small" for="caseTweakBattleWinnerTransferDurationMs">Pot transfer</label><input class="form-control form-control-sm" id="caseTweakBattleWinnerTransferDurationMs" type="number" min="250" max="20000" step="100"></div>
                                    </form>
                                </section>
                                <section class="case-admin-section case-battle-admin-section mb-0" aria-labelledby="caseTweakBattleRecoveryTitle">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div class="case-admin-section-title mb-0"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i><div><strong id="caseTweakBattleRecoveryTitle">Recovery queue</strong><span>Only expired waiting rooms and interrupted openings appear here. Results are never re-rolled.</span></div></div><button class="btn btn-outline-warning btn-sm" id="caseTweakBattleRefresh" type="button"><i class="fa-solid fa-rotate me-1" aria-hidden="true"></i>Refresh</button></div>
                                    <div class="case-admin-table-wrap"><div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>Battle</th><th>Creator</th><th>Progress</th><th>State</th></tr></thead><tbody id="caseTweakBattleRows"><tr><td colspan="4" class="text-center small-muted py-4">Open this tab to load battle health.</td></tr></tbody></table></div></div>
                                </section>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div class="modal fade" id="caseDailyDropModal" tabindex="-1" aria-labelledby="caseDailyDropModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content case-daily-drop-modal">
            <div class="modal-header">
                <div>
                    <p class="eyebrow mb-1">
                        <i class="fa-solid fa-parachute-box me-1" aria-hidden="true"></i>Daily Reward
                    </p>
                    <h2 class="modal-title h3" id="caseDailyDropModalTitle">Choose 2 rewards</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3 case-daily-drop-picker" id="caseDailyDropRewards"></div>
            </div>
            <div class="modal-footer">
                <span class="case-daily-drop-selection-status" id="caseDailyDropSelectionStatus">0 / 2 rewards selected</span>
                <button class="btn case-open-button case-daily-drop-claim" id="caseDailyDropClaim" type="button" disabled>
                    <i class="fa-solid fa-gift me-1" aria-hidden="true"></i>Claim selected rewards
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/page-case-battle-transition.js" asp-append-version="true"></script>
    @if (User.Identity?.IsAuthenticated == true) {
        @if (isCaseTycoonGuest) { <script src="~/js/pages/page-case-fan-notice.js" asp-append-version="true"></script> }
        <script src="~/js/pages/page-case-opening.js" asp-append-version="true"></script>
    }
    else { <script src="~/js/pages/page-case-guest-onboarding.js" asp-append-version="true"></script> }
}
