@page
@model PersonalTools.Pages.CaseOpening.IndexModel
@using System.Security.Claims
@using PersonalTools.Security
@using Microsoft.Extensions.Options
@using PersonalTools.Entities.CaseBattles
@inject IOptions<CaseBattleFeatureOptions> CaseBattleOptions
@{
    ViewData["Title"] = "CS2 Case Simulator";
    bool canManageCaseOpening = User.IsUserAllowedHere(AppRole.Admin);
    bool isCaseTycoonGuest = User.HasClaim(AppAuthorizationPolicies.AccountTypeClaim, AppAuthorizationPolicies.GuestAccount);
    string? currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

@section Head {
    <link rel="stylesheet" href="~/css/pages/page-case-opening.css?rev=daily-drop-picker" asp-append-version="true" />
}

<div class="container px-3 px-lg-4 case-opening-page" data-case-key="kilowatt">
    @Html.AntiForgeryToken()

    <section class="case-game-hud shadow-sm section-spacing" aria-label="Case simulator player status">
        <div class="case-hud-progression">
            <button class="case-hud-player case-hud-profile-trigger" type="button" data-bs-toggle="offcanvas" data-bs-target="#casePlayerProfile" aria-controls="casePlayerProfile" aria-label="Open player profile, achievements, statistics and collections">
                <span class="case-profile-avatar" id="caseProfileAvatar" aria-hidden="true">😎</span>
                <span class="case-hud-xp">
                    <span class="case-xp-bar-head">
                        <strong id="caseProfileBarTitle">@(User.Identity?.Name ?? "Username")’s profile</strong>
                        <span class="case-xp-text" id="caseXpText">0 / 100 XP</span>
                    </span>
                    <span class="case-xp-progress-row"><span class="case-xp-level-marker" id="caseXpLevelBadge">0</span><span class="case-xp-track" role="progressbar" aria-label="Level progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="caseXpTrack"><span class="case-xp-fill" id="caseXpFill"></span></span><span class="case-xp-level-marker" id="caseXpNextLevel">1</span></span>
                </span>
                <span class="case-hud-profile-cta" aria-hidden="true"><span>Open</span><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></span>
            </button>
            <button class="case-hud-daily-drop" id="caseDailyDrop" type="button" aria-live="polite" aria-hidden="true" aria-label="Daily Drop progress">
                <span class="case-profile-avatar case-daily-drop-avatar" aria-hidden="true">🎁</span>
                <span class="case-hud-xp"><span class="case-xp-bar-head"><strong>Daily Drop Progress</strong><span class="case-xp-text" id="caseDailyDropText">0%</span></span><span class="case-xp-progress-row"><span class="case-xp-level-marker">0</span><span class="case-xp-track case-daily-drop-track" role="progressbar" aria-label="Daily Drop progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="caseDailyDropTrack"><span class="case-xp-fill" id="caseDailyDropFill"></span></span><span class="case-xp-level-marker">100</span></span></span>
                <span class="case-hud-profile-cta" aria-hidden="true"><span>Drop</span><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></span>
            </button>
        </div>


        <div class="case-hud-status" aria-live="polite">
            <span class="case-hud-simulation"><i class="fa-solid fa-flask" aria-hidden="true"></i>Simulator</span>
            <span class="case-hud-metric" id="caseHudCapacity"><i class="fa-solid fa-boxes-stacked" aria-hidden="true"></i><span>0 / 1,000</span></span>
            <span class="case-hud-currencies" id="caseHudCurrencies" aria-label="Active case-opening currency balance">
                <span class="case-hud-stars" id="caseHudStars" aria-label="Stars balance">
                    <span class="case-stars-icon"><i class="fa-solid fa-star" aria-hidden="true"></i></span>
                    <strong id="caseStarsBalance">0</strong>
                </span>
                <span class="case-hud-gbp d-none" id="caseHudGbp" aria-label="GBP balance">
                    <span class="case-gbp-icon" aria-hidden="true">£</span>
                    <strong id="caseGbpBalance">£0</strong>
                </span>
            </span>
            @if (CaseBattleOptions.Value.Enabled)
            {
                <a class="case-hud-battles" asp-page="/CaseOpening/Battles/Create" data-case-battle-transition-link aria-label="Open Case Battles"><i class="fa-solid fa-trophy" aria-hidden="true"></i><span>Battles</span></a>
            }
            @if (canManageCaseOpening)
            {
                <button class="case-tweak-button" id="caseTweakButton" type="button" data-bs-toggle="modal" data-bs-target="#caseTweakModal" aria-label="Open variable tweak modal" title="Tweak variables (testing)">
                    <i class="fa-solid fa-wrench" aria-hidden="true"></i>
                </button>
            }
            <button class="case-tweak-button" id="casePlayerSettingsButton" type="button" data-bs-toggle="modal" data-bs-target="#casePlayerSettingsModal" aria-label="Open player settings" title="Player settings"><i class="fa-solid fa-gear" aria-hidden="true"></i></button>
        </div>

        <div class="case-level-up-toast d-none" id="caseLevelUpToast" aria-live="polite" aria-atomic="true">
            <span class="case-level-up-burst" aria-hidden="true"></span>
            <i class="fa-solid fa-star" aria-hidden="true"></i>
            <div><p>Level up!</p><strong id="caseLevelUpText">Level 1</strong></div>
        </div>
        <div class="case-hud-quick-controls" aria-label="Case Tycoon quick controls">
            <aside class="live-winners-dock case-live-winners-dock" id="liveWinnersDock" aria-label="Live Case Simulator winners">
                <button class="live-winners-trigger" id="liveWinnersTrigger" type="button" aria-expanded="false" aria-controls="liveWinnersPanel">
                    <span class="live-winners-live-dot" aria-hidden="true"></span><span class="live-winners-count" id="liveWinnersCount">—</span>
                </button>
                <section class="live-winners-panel" id="liveWinnersPanel" hidden>
                    <div class="live-winners-header"><div><p>24-hour hall of fame</p><h2 id="liveWinnersTitle">Recent winners</h2></div><div class="case-user-scope" role="group" aria-label="Online player count"><button class="active" type="button" data-user-scope="global" aria-pressed="true">Global</button><button type="button" data-user-scope="friends" aria-pressed="false">Friends</button></div></div>
                    <div class="live-winners-tabs" role="tablist" aria-label="Hall of fame category"><button class="active" type="button" role="tab" data-live-winners-tab="pulls" aria-selected="true">Daily pulls</button><button type="button" role="tab" data-live-winners-tab="battles" aria-selected="false">Battle winners</button></div>
                    <ol class="live-winners-list" id="liveWinnersList"><li class="live-winners-empty">Loading the latest wins…</li></ol>
                    <span class="live-winners-scroll-cue" id="liveWinnersScrollCue" aria-hidden="true" hidden><i class="fa-solid fa-chevron-down"></i></span>
                </section>
            </aside>
            <button class="case-daily-drop-recall d-none" id="caseDailyDropRecall" type="button" aria-label="Reopen Daily Drop rewards" title="Daily Drop ready">
                <i class="fa-solid fa-parachute-box" aria-hidden="true"></i><span>Daily Drop</span>
            </button>
        </div>
    </section>

    <section class="case-game-panel case-shop case-tab-start section-spacing d-none" id="caseShop" data-case-destination-panel="shop" aria-labelledby="caseShopTitle">
        <div class="card-body p-3 p-lg-4">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-3">
                <div>
                    <p class="eyebrow mb-1">Simulator marketplace</p>
                    <h2 class="h4 mb-1" id="caseShopTitle">Shop</h2>
                    <p class="small-muted mb-0">Browse the full catalogue, unlock what you want, then restock in a couple of taps.</p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="case-panel-refresh" type="button" data-refresh-destination="shop" aria-label="Refresh shop" title="Refresh shop"><i class="fa-solid fa-rotate" aria-hidden="true"></i></button>
                    <span class="case-shop-stars"><i class="fa-solid fa-star" aria-hidden="true"></i><strong id="caseShopStarsBalance">0</strong></span>
                </div>
            </div>

            <div class="case-shop-controls row g-2 align-items-end mb-3">
                <div class="col-12 col-md">
                    <label class="form-label small fw-semibold mb-1" for="caseShopSearch">Find a case or capsule</label>
                    <input class="form-control" id="caseShopSearch" type="search" placeholder="Search the catalogue" autocomplete="off" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small fw-semibold mb-1" for="caseShopTier">Tier</label>
                    <select class="form-select" id="caseShopTier"><option value="">All tiers</option></select>
                </div>
            </div>
            <div class="case-shop-type-filter mb-3" id="caseShopTypeFilter" role="group" aria-label="Filter shop catalogue">
                <button class="btn btn-outline-secondary btn-sm is-active" type="button" data-shop-type="" aria-pressed="true">All</button>
                <button class="btn btn-outline-secondary btn-sm" type="button" data-shop-type="case" aria-pressed="false">Cases</button>
                <button class="btn btn-outline-secondary btn-sm" type="button" data-shop-type="sticker" aria-pressed="false">Sticker capsules</button>
                <button class="btn btn-outline-secondary btn-sm" type="button" data-shop-type="souvenir" aria-pressed="false">Souvenir packages</button>
            </div>
            <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                <span class="small-muted" id="caseShopResultCount">0 cases</span>
                <span class="small-muted">Permanent unlocks · repeatable stock</span>
            </div>
            <div class="row g-2" id="caseShopCaseGrid" aria-live="polite"></div>
        </div>
    </section>

    <section class="case-game-panel case-upgrades-store case-tab-start section-spacing d-none" id="caseUpgradeStore" data-case-destination-panel="upgrades" aria-labelledby="caseUpgradeStoreTitle">
        <div class="card-body p-3 p-lg-4">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-3">
                <div>
                    <p class="eyebrow mb-1">Simulator progression</p>
                    <h2 class="h4 mb-1" id="caseUpgradeStoreTitle">Upgrades</h2>
                    <p class="small-muted mb-0">Improve your workshop, inventory and opening options with permanent Star upgrades.</p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="case-panel-refresh" type="button" data-refresh-destination="upgrades" aria-label="Refresh upgrades" title="Refresh upgrades"><i class="fa-solid fa-rotate" aria-hidden="true"></i></button>
                    <span class="case-shop-stars"><i class="fa-solid fa-star" aria-hidden="true"></i><strong id="caseUpgradeStarsBalance">0</strong></span>
                </div>
            </div>
            <section class="case-skill-tree-shell d-none" id="caseSkillTreeShell" aria-labelledby="caseSkillTreeTitle">
                <div class="case-skill-tree-intro">
                    <div>
                        <p class="eyebrow mb-1">Workshop progression</p>
                        <h3 class="h5 mb-1" id="caseSkillTreeTitle">Opening mastery</h3>
                        <p class="small-muted mb-0">Advance through connected upgrades to build a faster opening workflow.</p>
                    </div>
                    <span class="case-skill-tree-balance"><small>Available</small><strong id="caseSkillTreeBalance">0</strong></span>
                </div>
                <div class="case-skill-tree-legend" aria-label="Upgrade node states">
                    <span><i class="is-locked"></i>Locked</span>
                    <span><i class="is-available"></i>Available</span>
                    <span><i class="is-purchased"></i>Purchased</span>
                    <span><i class="is-complete"></i>Mastered</span>
                </div>
                <div class="case-skill-tree" id="caseSkillTree" role="tree" aria-label="Case Tycoon upgrade tree"></div>
                <section class="case-skill-tree-automation d-none" id="caseSkillTreeAutomationControls" aria-labelledby="caseSkillTreeAutomationTitle">
                    <div class="case-skill-tree-automation-heading">
                        <div>
                            <p class="eyebrow mb-1">Unlocked controls</p>
                            <h4 class="h6 mb-1" id="caseSkillTreeAutomationTitle">Automation command deck</h4>
                            <p class="small-muted mb-0">Configure the automation abilities you have unlocked above.</p>
                        </div>
                    </div>
                    <div class="case-skill-tree-automation-grid" id="caseSkillTreeAutomationHost"></div>
                </section>
                <p class="visually-hidden" id="caseSkillTreeStatus" aria-live="polite"></p>
            </section>
            <div class="row g-3" id="caseLegacyUpgradeStoreContent">
                <div class="col-12">
                    <article class="case-shop-storage" id="caseShopStorageCard">
                        <div>
                            <span class="case-shop-icon"><i class="fa-solid fa-box-archive" aria-hidden="true"></i></span>
                            <h3 class="h5 mb-1">Storage container</h3>
                            <p class="small-muted mb-0" id="caseShopStorageCopy">Adds 1,000 permanent inventory slots.</p>
                        </div>
                        <div class="case-shop-storage-action">
                            <strong id="caseShopStorageStatus">0 / 0 owned</strong>
                            <span class="case-upgrade-card-metric d-block mt-1" id="caseShopStorageCapacity">1,000 slots · 0 used</span>
                            <button class="btn btn-warning btn-sm d-block ms-lg-auto mt-2" id="purchaseStorageContainer" type="button">Buy storage</button>
                        </div>
                    </article>
                </div>
                <div class="col-12">
                    <section class="case-daily-upgrade-panel" aria-labelledby="caseDailyUpgradeTitle">
                        <button class="case-daily-upgrade-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#caseDailyUpgradeTree" aria-expanded="false" aria-controls="caseDailyUpgradeTree">
                            <span class="case-daily-upgrade-toggle-icon"><i class="fa-solid fa-sun" aria-hidden="true"></i></span>
                            <span><span class="eyebrow d-block mb-1">Daily progression</span><strong id="caseDailyUpgradeTitle">Daily Drop mastery</strong><small>Spend Stars to shape the rewards waiting at the end of each Daily Drop.</small></span>
                            <i class="fa-solid fa-chevron-down case-daily-upgrade-chevron" aria-hidden="true"></i>
                        </button>
                        <div class="collapse" id="caseDailyUpgradeTree"><div class="case-daily-upgrade-tree" id="caseDailyUpgradeTreeCards"></div></div>
                    </section>
                </div>
                <div class="col-12">
                    <div class="case-upgrade-section-heading mt-2 mb-3"><span class="case-shop-icon"><i class="fa-solid fa-layer-group" aria-hidden="true"></i></span><div><p class="eyebrow mb-1">Permanent capacity</p><h3 class="h5 mb-1">Workshop shelving</h3><p class="small-muted mb-0">Cases and skins both use one inventory slot. Add permanent shelving as your collection and case stock grow.</p></div></div>
                    <div class="row g-3" id="caseCapacityUpgradeGrid"></div>
                    <p class="case-upgrade-card-metric mt-2 mb-0" id="caseCapacityUpgradeStatus">0 bonus slots unlocked</p>
                </div>
                <div class="col-12">
                    <div class="case-upgrade-section-heading mt-2 mb-3"><span class="case-shop-icon"><i class="fa-solid fa-gauge-high" aria-hidden="true"></i></span><div><p class="eyebrow mb-1">Open faster</p><h3 class="h5 mb-1">Opening controls</h3><p class="small-muted mb-0">Make repeat openings quicker and expand the number of cases opened together.</p></div></div>
                    <div class="row g-2" id="caseShopUpgradeGrid"></div>
                </div>
                <div class="col-12">
                    <div class="case-upgrade-section-heading mt-2 mb-3"><span class="case-shop-icon"><i class="fa-solid fa-comment-dots" aria-hidden="true"></i></span><div><p class="eyebrow mb-1">Battle expression</p><h3 class="h5 mb-1">Reactions &amp; stickers</h3><p class="small-muted mb-0">Unlock new emojis and picture reactions to send during live case battles.</p></div></div>
                    <div class="row g-2 case-reaction-upgrade-grid" id="caseBattleReactionUpgradeGrid"><div class="col-12"><p class="small-muted mb-0">Loading battle reactions…</p></div></div>
                </div>
                <div class="col-12">
                    <div class="case-upgrade-section-heading mt-2 mb-3"><span class="case-shop-icon"><i class="fa-solid fa-robot" aria-hidden="true"></i></span><div><p class="eyebrow mb-1">Background opening</p><h3 class="h5 mb-1">Bot workshop</h3><p class="small-muted mb-0">Add server bays, then fill them with opening bots.</p></div></div>
                    <div class="row g-2">
                        <div class="col-12 col-md-6"><article class="case-shop-row"><div><h3 class="h6 mb-1">Bot server</h3><p class="small-muted mb-0">Adds four bot bays to your workshop.</p></div><div class="case-upgrade-card-action"><span class="case-upgrade-card-metric" id="caseUpgradeServerOwnership">0 servers</span><button class="btn btn-outline-warning btn-sm js-shop-buy-server" type="button">Buy server</button></div></article></div>
                        <div class="col-12 col-md-6"><article class="case-shop-row"><div><h3 class="h6 mb-1">Opening bot</h3><p class="small-muted mb-0">Opens an owned case while the page is active.</p></div><div class="case-upgrade-card-action"><span class="case-upgrade-card-metric" id="caseUpgradeBotOwnership">0/0 bots</span><button class="btn btn-outline-warning btn-sm js-shop-buy-bot" type="button">Buy bot</button></div></article></div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="case-upgrade-section-heading mt-2 mb-3">
                        <span class="case-shop-icon">
                            <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
                        </span>
                        <div>
                            <p class="eyebrow mb-1">Automate your inventory</p>
                            <h3 class="h5 mb-1">Selling, restocking and trade-ups</h3>
                            <p class="small-muted mb-0">Start with quicker manual selling, then automate the routines that keep your inventory moving.</p>
                        </div>
                    </div>
                    <div class="row g-3" id="caseInventoryUpgradeGrid"></div>
                    <div class="case-auto-sell-panel mt-3" id="caseBulkSellPanel">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <div><p class="eyebrow mb-1">Inventory throughput</p><h3 class="h6 mb-1">Bulk selling</h3><p class="small-muted mb-0" id="caseBulkSellUpgradeDescription">Sell up to 100 items at once. Raise the limit as your inventory grows.</p></div>
                            <button class="btn btn-outline-warning btn-sm js-unlock-inventory-upgrade d-none" type="button" id="caseBulkSellUpgradeButton"></button>
                        </div>
                        <span class="case-upgrade-card-metric mt-3" id="caseBulkSellStatus">Current limit: 100 items</span>
                    </div>
                    <span class="d-none" id="caseAutoSellPanelHome"></span>
                    <div class="case-auto-sell-panel mt-3" id="caseAutoSellPanel">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3"><div><p class="eyebrow mb-1">Automatic selling</p><h3 class="h6 mb-1">Rarity control deck</h3><p class="small-muted mb-0" id="caseAutoSellUpgradeDescription">Begin with rare Covert drops, then work toward the more common tiers for stronger passive Star income.</p></div><button class="btn btn-outline-warning btn-sm js-unlock-inventory-upgrade d-none" type="button" id="caseAutoSellUpgradeButton"></button></div>
                        <ol class="case-auto-sell-progression" id="caseAutoSellProgression" aria-label="Auto-sell unlock progression"></ol>
                        <div class="case-preserve-stattrak-control mt-3" id="casePreserveStatTrakControl"><div class="form-check form-switch m-0"><input class="form-check-input pt-switch" id="casePreserveStatTrak" type="checkbox" checked disabled /><label class="form-check-label small fw-semibold" for="casePreserveStatTrak">Always keep StatTrak™</label></div><small id="casePreserveStatTrakHint">Unlock an auto-sell tier first</small></div>
                        <div class="case-auto-sell-grid" id="caseAutoSellControls"></div>
                    </div>
                </div>
                <div class="col-12">
                    <span class="d-none" id="caseAutoBuyPanelHome"></span>
                    <div class="case-auto-sell-panel mt-3" id="caseAutoBuyPanel">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                            <div>
                                <p class="eyebrow mb-1">Automatic restocking</p>
                                <h3 class="h6 mb-1">Auto-buy</h3>
                                <p class="small-muted mb-0" id="caseAutoBuyUpgradeDescription">Automatically repurchase cases when your owned stock runs low.</p>
                            </div>
                            <button class="btn btn-outline-warning btn-sm js-unlock-inventory-upgrade d-none" type="button" id="caseAutoBuyUpgradeButton"></button>
                        </div>
                        <div id="caseAutoBuyRuleEditor" class="d-none">
                            <p class="small-muted mb-2" id="caseAutoBuyPanelCopy">Set a threshold and quantity per case - when your owned stock drops below it, the Shop buys more for you.</p>
                            <div class="case-auto-buy-add-row d-none" id="caseAutoBuyAddRow">
                                <select class="form-select form-select-sm" id="caseAutoBuyAddCase"></select>
                                <label class="case-auto-buy-row-field"><span>Below</span><input class="form-control form-control-sm" type="number" min="0" step="1" id="caseAutoBuyAddThreshold" value="5" /></label>
                                <label class="case-auto-buy-row-field"><span>Buy</span><input class="form-control form-control-sm" type="number" min="1" step="1" id="caseAutoBuyAddQuantity" value="10" /></label>
                                <button class="btn btn-warning btn-sm" type="button" id="caseAutoBuyAddButton">Add rule</button>
                            </div>
                            <div class="d-flex justify-content-end mb-2"><span class="case-upgrade-card-metric" id="caseAutoBuyRuleStatus"></span></div>
                            <div class="case-auto-buy-grid" id="caseAutoBuyRules"></div>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="case-auto-sell-panel mt-3" id="caseTradeUpUpgradePanel">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                            <div>
                                <p class="eyebrow mb-1">Inventory crafting</p>
                                <h3 class="h6 mb-1">Auto trade-up</h3>
                                <p class="small-muted mb-0" id="caseTradeUpUnlockDescription">Automatically fire Trade Up Contracts toward a target skin.</p>
                            </div>
                            <button class="btn btn-outline-warning btn-sm js-unlock-inventory-upgrade d-none" type="button" id="caseTradeUpUnlockButton"></button>
                        </div>
                        <div id="caseTradeUpUpgradeTiers" class="d-none">
                            <div class="case-trade-up-upgrade-card">
                                <div><h3 class="h6 mb-1">Recipe slots</h3><p class="small-muted mb-0" id="caseTradeUpSlotsDescription">Raise how many recipes you can have active at once.</p></div>
                                <button class="btn btn-outline-warning btn-sm" type="button" id="caseTradeUpSlotsUpgradeButton">Add slot</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="case-game-panel case-stage case-tab-start section-spacing" data-case-destination-panel="open" aria-labelledby="caseName">
        <canvas class="case-effects-canvas" id="caseEffectsCanvas" aria-hidden="true"></canvas>
        <div class="case-gold-reveal d-none" id="caseGoldReveal" role="dialog" aria-modal="true" aria-labelledby="caseGoldRevealName" aria-describedby="caseGoldRevealMeta" aria-live="polite" aria-atomic="true" tabindex="-1">
            <span class="case-gold-ring case-gold-ring-one" aria-hidden="true"></span>
            <span class="case-gold-ring case-gold-ring-two" aria-hidden="true"></span>
            <span class="case-gold-slash" aria-hidden="true"></span>
            <span class="case-gold-scan" aria-hidden="true"></span>
            <div class="case-gold-content">
                <p id="caseGoldRevealEyebrow">Rare special item</p>
                <div class="case-gold-image-stage">
                    <img class="case-gold-silhouette case-gold-base-silhouette" id="caseGoldRevealBaseSilhouette" alt="" aria-hidden="true" />
                    <img class="case-gold-silhouette" id="caseGoldRevealSilhouette" alt="" aria-hidden="true" />
                    <img class="case-gold-item-image" id="caseGoldRevealImage" alt="" />
                </div>
                <h3 id="caseGoldRevealName"></h3>
                <span id="caseGoldRevealMeta"></span>
                <small><i class="fa-solid fa-computer-mouse me-1" aria-hidden="true"></i>Click anywhere to continue</small>
            </div>
        </div>
        <div class="card-body p-3 p-lg-4 p-xl-5">
            <div class="case-stage-header">
                <div class="case-stage-identity">
                    <p class="eyebrow mb-1" id="caseType">Weapon Case</p>
                    <h2 class="h3 fw-semibold mb-0" id="caseName">Kilowatt Case</h2>
                </div>
