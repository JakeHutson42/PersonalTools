@if (canManageCaseOpening)
{
    <div class="modal fade" id="caseTweakResetModal" tabindex="-1" aria-labelledby="caseTweakResetTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="caseTweakResetTitle">Reset as new player?</h2>
