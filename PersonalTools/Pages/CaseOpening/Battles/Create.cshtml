@page
@model PersonalTools.Pages.CaseOpening.Battles.CreateModel
@{ ViewData["Title"] = "Create case battle"; }
@section Head { <link rel="stylesheet" href="~/css/pages/page-case-opening.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/pages/page-case-battles.css" asp-append-version="true" /> }
<main class="container px-3 px-lg-4 case-opening-page case-battle-game-page case-battles-page" data-case-battle-create>
 @Html.AntiForgeryToken()
 <partial name="_CaseBattleHud" />
 <header class="case-battle-room-header"><div><p class="eyebrow mb-1">CS2 Case Simulator</p><h1 class="h3 mb-1">Create case battle</h1><p class="small-muted mb-0">Choose your rival, build the case track, then send the challenge.</p></div><a class="btn btn-outline-secondary" asp-page="/CaseOpening/Index" data-case-battle-transition-link>Cancel</a></header>
 <section class="case-battle-pending-created case-battle-incoming-list d-none" id="caseBattleIncomingInvitations" aria-live="polite"><div class="case-battle-pending-created-heading"><div><p class="eyebrow mb-1">Battle invitations</p><strong>Challenges waiting for you</strong></div><span>Missed invitations remain here until they expire</span></div><div id="caseBattleIncomingInvitationList"></div></section>
 <section class="case-battle-pending-created d-none" id="caseBattlePendingCreated" aria-live="polite"><div class="case-battle-pending-created-heading"><div><p class="eyebrow mb-1">Your invitations</p><strong>Waiting for a response</strong></div><span>Open or cancel any pending challenge</span></div><div id="caseBattlePendingCreatedList"></div></section>
 <section class="card case-battle-room case-battle-opponent-stage" aria-labelledby="caseBattleOpponentHeading"><div class="card-body"><div class="case-battle-mode-picker" aria-labelledby="caseBattleModeLabel"><div><p class="eyebrow mb-1" id="caseBattleModeLabel">Battle format</p><strong>Choose how many solo players compete</strong></div><div class="btn-group" role="group" aria-label="Battle format"><button class="btn btn-outline-warning active" type="button" data-battle-mode="duel" aria-pressed="true">1v1</button><button class="btn btn-outline-warning" type="button" data-battle-mode="ffa-3" aria-pressed="false" disabled>1v1v1</button><button class="btn btn-outline-warning" type="button" data-battle-mode="ffa-4" aria-pressed="false" disabled>1v1v1v1</button></div></div><hr class="my-3" /><div class="case-battle-section-heading"><div><p class="eyebrow mb-1">Step 1 · Choose your rivals</p><h2 class="h5 mb-0" id="caseBattleOpponentHeading">Who are you challenging?</h2><p class="small-muted mb-0 mt-1" id="caseBattleOpponentHelp">Your shared unlocked cases are checked as soon as you select a player.</p></div><span class="case-battle-step-status" id="caseBattleOpponentStatus"><i class="fa-solid fa-user-clock" aria-hidden="true"></i> Choose one</span></div><input id="caseBattleMode" type="hidden" value="duel" /><label class="visually-hidden" for="caseBattleOpponent">Opponent</label><select class="visually-hidden" id="caseBattleOpponent" disabled tabindex="-1" aria-hidden="true"><option value="">Loading users…</option></select><div class="case-battle-opponent-grid" id="caseBattleOpponentCards" role="listbox" aria-label="Available opponents" aria-live="polite"><div class="case-battle-opponent-loading"><i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i><span>Scouting available opponents…</span></div></div></div></section>
 <div class="row g-3 case-battle-build-flow"><section class="col-lg-7"><div class="card case-battle-room case-battle-picker"><div class="card-body"><div class="case-battle-section-heading"><div><p class="eyebrow mb-1">Step 2 · Set the stake</p><h2 class="h5 mb-0">Build the case track</h2></div><span class="case-battle-selection-count" id="caseBattleSelectionCount" aria-live="polite"><b>0</b><small>/ 20 selected</small></span></div><div class="case-battle-catalogue-toolbar"><div class="input-group"><span class="input-group-text"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></span><input class="form-control" id="caseBattleCaseSearch" type="search" placeholder="Search eligible cases…" autocomplete="off" aria-label="Search cases" /></div><div class="btn-group" role="group" aria-label="Catalogue view"><button class="btn btn-outline-secondary active" id="caseBattleGridView" type="button" aria-pressed="true" title="Card view"><i class="fa-solid fa-grip" aria-hidden="true"></i></button><button class="btn btn-outline-secondary" id="caseBattleListView" type="button" aria-pressed="false" title="List view"><i class="fa-solid fa-list" aria-hidden="true"></i></button></div></div><div id="caseBattleCreateCases" class="case-battle-catalogue is-grid" aria-live="polite"></div><p class="case-battle-empty d-none" id="caseBattleSearchEmpty">Choose an opponent to reveal eligible cases.</p></div></div></section>
 <aside class="col-lg-5"><div class="card case-battle-room case-battle-summary-card"><div class="card-body"><p class="eyebrow mb-1">Step 3 · Review</p><h2 class="h5">Lock in the battle order</h2><p class="small-muted" id="caseBattleContributionCopy">Both players contribute one of every case below. Reorder the rounds before sending your invitation.</p><div class="case-battle-selected-heading"><strong>Battle order</strong><span>Use arrows to reorganise</span></div><div id="caseBattleSelectedCases" class="case-battle-selected mb-3" aria-live="polite"></div></div></div></aside></div>
 <aside class="case-battle-action-tray" id="caseBattleActionTray" aria-label="Case battle action summary"><div><span class="eyebrow">Battle stake</span><strong id="caseBattleCreateSummary">Choose at least one case.</strong></div><div><button class="btn btn-outline-warning" type="button" id="caseBattleBuyAll" disabled><i class="fa-solid fa-cart-shopping me-1" aria-hidden="true"></i>Buy missing</button><button class="btn btn-warning" type="button" id="caseBattleCreate" disabled><i class="fa-solid fa-paper-plane me-1" aria-hidden="true"></i>Send invitation</button></div></aside>
</main>
<partial name="_CaseBattleTransition" />
@section Scripts { <script src="~/js/pages/page-case-battle-transition.js" asp-append-version="true"></script><script src="~/js/pages/page-case-battle-hud.js" asp-append-version="true"></script><script src="~/js/pages/page-case-battle-create.js" asp-append-version="true"></script> }
