<section class="case-game-hud case-battle-game-hud shadow-sm" aria-label="Case Tycoon player status">
    <a class="case-hud-player case-hud-profile-trigger" asp-page="/CaseOpening/Index" aria-label="Open your Case Tycoon profile and simulator">
        <span class="case-xp-level-badge" id="caseBattleHudLevel">Lv 0</span>
        <span class="case-hud-xp">
            <span class="case-xp-bar-head"><strong>Player profile</strong><span class="case-xp-text" id="caseBattleHudXp">0 / 100 XP</span></span>
            <span class="case-xp-track" id="caseBattleHudXpTrack" role="progressbar" aria-label="Level progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span class="case-xp-fill" id="caseBattleHudXpFill"></span></span>
        </span>
        <span class="case-hud-profile-cta" aria-hidden="true"><span>Profile</span><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></span>
    </a>
</section>
