@page
@model PersonalTools.Pages.Admin.CaseBattles.IndexModel
@{ ViewData["Title"] = "Case battle reconciliation"; }
<div class="container px-3 px-lg-4">
    @Html.AntiForgeryToken()
    <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 section-spacing">
        <div><p class="eyebrow mb-1">Administration</p><h1 class="page-title mb-2">Case battle reconciliation</h1><p class="page-subtitle mb-0">Review pending and interrupted battles. Administrators can cancel any waiting battle and return its escrowed cases; opening battles remain visible for recovery and are never re-rolled here.</p></div>
        <button class="btn btn-outline-secondary" id="caseBattleAdminRefresh" type="button"><i class="fa-solid fa-rotate me-2" aria-hidden="true"></i>Refresh</button>
    </div>
    <section class="card app-surface-card mb-3"><div class="card-body p-3 p-lg-4"><div class="d-flex flex-wrap align-items-center justify-content-between gap-3"><div><p class="eyebrow mb-1">Feature visibility</p><h2 class="h5 mb-1">Case Battles</h2><p class="small-muted mb-0">Controls whether players can create battles or use Buy all. Existing battles remain recoverable.</p></div><div class="form-check form-switch pt-switch"><input class="form-check-input" type="checkbox" role="switch" id="caseBattlesEnabled"><label class="form-check-label" for="caseBattlesEnabled">Visible to players</label></div></div><hr class="my-4" /><div class="d-flex flex-wrap align-items-center justify-content-between gap-3"><div><p class="eyebrow mb-1">System opponent</p><h2 class="h5 mb-1">Battle Bot</h2><p class="small-muted mb-0">When visible, players can start an instant 1v1. Bot winnings are recorded then discarded.</p></div><div class="form-check form-switch pt-switch"><input class="form-check-input" type="checkbox" role="switch" id="caseBattleBotEnabled"><label class="form-check-label" for="caseBattleBotEnabled">Visible to players</label></div></div><div class="row g-2 mt-3" id="caseBattleBotStats"><div class="col-6 col-md-3"><span class="small-muted d-block">Attempted</span><strong>—</strong></div><div class="col-6 col-md-3"><span class="small-muted d-block">Won</span><strong>—</strong></div><div class="col-6 col-md-3"><span class="small-muted d-block">Skins discarded</span><strong>—</strong></div><div class="col-6 col-md-3"><span class="small-muted d-block">Value discarded</span><strong>—</strong></div></div></div></section>
<section class="card app-surface-card mb-3"><div class="card-body p-3 p-lg-4"><div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-3"><div><p class="eyebrow mb-1">Battle rules &amp; pacing</p><h2 class="h5 mb-1">Battle settings</h2><p class="small-muted mb-0">Case limit applies to new battles. Timings are milliseconds; reduced-motion users skip waits and animations.</p></div><button type="button" class="btn btn-primary" id="caseBattleTimingsSave">Save settings</button></div><form id="caseBattleTimingsForm" class="row g-3"><div class="col-6 col-lg-3"><label class="form-label" for="maxCasesPerBattle">Cases per battle</label><input class="form-control" id="maxCasesPerBattle" type="number" min="1" max="50" step="1"></div><div class="col-6 col-lg-3"><label class="form-label" for="readyPauseMs">Ready pause</label><input class="form-control" id="readyPauseMs" type="number" min="0" max="10000" step="100"></div><div class="col-6 col-lg-3"><label class="form-label" for="readyCountdownMs">Countdown</label><input class="form-control" id="readyCountdownMs" type="number" min="0" max="15000" step="100"></div><div class="col-6 col-lg-3"><label class="form-label" for="preSpinPauseMs">Pre-spin attention delay</label><input class="form-control" id="preSpinPauseMs" type="number" min="0" max="10000" step="100"></div><div class="col-12 col-lg-6"><label class="form-label" for="spinDurationMs">Total spin time</label><input class="form-control" id="spinDurationMs" type="number" min="3000" max="5000" step="100" aria-describedby="spinDurationHelp"><div class="form-text" id="spinDurationHelp">3–5 seconds including a fixed final second resting on the received skin.</div></div><div class="col-6 col-lg-3"><label class="form-label" for="resultsPauseMs">Results pause</label><input class="form-control" id="resultsPauseMs" type="number" min="0" max="10000" step="100"></div><div class="col-6 col-lg-3"><label class="form-label" for="winnerIntroPauseMs">Winner intro</label><input class="form-control" id="winnerIntroPauseMs" type="number" min="0" max="10000" step="100"></div><div class="col-6 col-lg-3"><label class="form-label" for="winnerTallyDurationMs">Tally duration</label><input class="form-control" id="winnerTallyDurationMs" type="number" min="250" max="20000" step="100"></div><div class="col-6 col-lg-3"><label class="form-label" for="winnerVerdictPauseMs">Verdict pause</label><input class="form-control" id="winnerVerdictPauseMs" type="number" min="0" max="10000" step="100"></div><div class="col-6 col-lg-3"><label class="form-label" for="winnerTransferDurationMs">Pot transfer</label><input class="form-control" id="winnerTransferDurationMs" type="number" min="250" max="20000" step="100"></div></form></div></section>
    <section class="card app-surface-card"><div class="card-body p-3 p-lg-4"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Battle</th><th>State</th><th>Creator</th><th>Progress</th><th>Attention</th><th class="text-end">Action</th></tr></thead><tbody id="caseBattleAdminRows"><tr><td colspan="6" class="text-center small-muted py-5">Loading unresolved battles…</td></tr></tbody></table></div></div></section>
</div>
@section Scripts { <script src="~/js/pages/page-admin-case-battles.js" asp-append-version="true"></script> }
